---
import type { NoteTopic } from "../lib/note-topics";
import { noteTopicPath } from "../lib/note-topics";
import { formatDate } from "../lib/posts";
import { withBase } from "../lib/url";

interface Props {
  topics: NoteTopic[];
}

const { topics } = Astro.props;
---

{
  topics.length > 0 ? (
    <ol class="topic-list">
      {topics.map((topic, index) => (
        <li>
          <a class="topic-row" href={withBase(noteTopicPath(topic.slug))}>
            <span class="topic-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <span class="topic-copy">
              <strong>{topic.name}</strong>
              <time datetime={topic.posts[0].data.published.toISOString()}>
                最近更新 {formatDate(topic.posts[0].data.published)}
              </time>
            </span>
            <span class="topic-count">
              {topic.posts.length === 1 ? "1 篇筆記" : `${topic.posts.length} 篇筆記`}
            </span>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <div class="empty-state">
      <h2>還沒有主題</h2>
      <p>第一個學習主題整理完成後，會從這裡開始出現。</p>
    </div>
  )
}