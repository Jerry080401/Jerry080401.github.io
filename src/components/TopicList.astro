---
import type { NoteTopic } from "../lib/note-topics";
import { defaultLocale, interpolate, localePath, messages, type Locale } from "../i18n";
import { noteTopicPath } from "../lib/note-topics";
import { formatDate } from "../lib/posts";
import { withBase } from "../lib/url";

interface Props {
  topics: NoteTopic[];
  locale?: Locale;
}

const { topics, locale = defaultLocale } = Astro.props;
const copy = messages[locale];
---

{
  topics.length > 0 ? (
    <ol class="topic-list">
      {topics.map((topic, index) => (
        <li>
          <a class="topic-row" href={withBase(localePath(locale, noteTopicPath(topic.slug)))}>
            <span class="topic-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <span class="topic-copy">
              <strong>{topic.name}</strong>
              <time datetime={topic.posts[0].data.published.toISOString()}>
                {copy.latestUpdate} {formatDate(topic.posts[0].data.published, locale)}
              </time>
            </span>
            <span class="topic-count">
              {topic.posts.length === 1 ? copy.oneNote : interpolate(copy.manyNotes, { count: topic.posts.length })}
            </span>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <div class="empty-state">
      <h2>{copy.noTopicsTitle}</h2>
      <p>{copy.noTopicsText}</p>
    </div>
  )
}