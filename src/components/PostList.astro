---
import type { Post } from "../lib/posts";
import { defaultLocale, messages, type Locale } from "../i18n";
import { formatDate, postPath } from "../lib/posts";
import { withBase } from "../lib/url";

interface Props {
  posts: Post[];
  locale?: Locale;
  emptyTitle?: string;
  emptyText?: string;
}

const { locale = defaultLocale, posts, emptyTitle, emptyText } = Astro.props;
const copy = messages[locale];
const resolvedEmptyTitle = emptyTitle ?? copy.homeEmptyTitle;
const resolvedEmptyText = emptyText ?? copy.homeEmptyText;
const metaLabel = (post: Post) => post.data.category === "學習筆記"
  ? (post.data.topic?.name ?? copy.navNotes)
  : copy.navArticles;
---

{
  posts.length > 0 ? (
    <ol class="post-list">
      {posts.map((post) => (
        <li>
          <article>
            <div class="post-meta">
              <time datetime={post.data.published.toISOString()}>
                {formatDate(post.data.published, post.data.locale)}
              </time>
              <span>{metaLabel(post)}</span>
            </div>
            <div class="post-copy">
              <h2><a href={withBase(postPath(post))}>{post.data.title}</a></h2>
              {post.data.description && <p>{post.data.description}</p>}
            </div>
          </article>
        </li>
      ))}
    </ol>
  ) : (
    <div class="empty-state">
      <h2>{resolvedEmptyTitle}</h2>
      <p>{resolvedEmptyText}</p>
    </div>
  )
}