---
import { site } from "../config";
import { withBase } from "../lib/url";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: boolean;
  noindex?: boolean;
}

const { title, description = site.description, canonical = true, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.title}` : `${site.title} — ${site.subtitle}`;
const pathname = Astro.url.pathname;
const isHome = pathname === withBase("/");
const sectionLabel = isHome ? "" : (title ?? "PAGE");
const isActive = (href: string) => {
  const target = withBase(href);
  return href === "/" ? pathname === target : pathname.startsWith(target);
};
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase("/favicon.ico")} />
    {canonical && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <link rel="alternate" type="application/rss+xml" title={site.title} href={withBase("/rss.xml")} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">跳至主要內容</a>

    <div class="app-shell">
      <aside class="side-rail">
        <div class="rail-brand-space">
          {!isHome && (
            <a class="rail-brand" href={withBase("/")} aria-label={`${site.title} 首頁`}>
              <strong>Jerry's<br />Notes</strong>
              <span>{site.subtitle}</span>
            </a>
          )}
        </div>

        <nav class="rail-nav" aria-label="主要導覽">
          {
            site.navigation.map((item) => (
              <a href={withBase(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="rail-footer">
          <a href={withBase("/rss.xml")}>RSS</a>
          <span>© {new Date().getFullYear()} {site.author}</span>
        </div>
      </aside>

      <div class="page-column">
        <header class="mobile-header">
          <div class="mobile-brand-space">
            {!isHome && <a href={withBase("/")}>{site.title}</a>}
          </div>
          <button
            class="menu-button"
            id="menu-button"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-navigation"
            aria-label="開啟選單"
          >
            <span></span><span></span>
          </button>
          <button class="theme-button" type="button" aria-label="切換深色模式">
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="3.5"></circle>
              <path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
            </svg>
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 15.2A8.2 8.2 0 0 1 8.8 4a8.2 8.2 0 1 0 11.2 11.2Z"></path>
            </svg>
          </button>
          <nav id="mobile-navigation" class="mobile-nav" aria-label="行動版導覽" hidden>
            {
              site.navigation.map((item) => (
                <a href={withBase(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              ))
            }
          </nav>
        </header>

        <div class="utility-bar">
          <span>{sectionLabel}</span>
          <div>
            <a href={withBase("/rss.xml")}>RSS</a>
            <button class="theme-button" type="button" aria-label="切換深色模式">
              <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="3.5"></circle>
                <path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
              </svg>
              <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 15.2A8.2 8.2 0 0 1 8.8 4a8.2 8.2 0 1 0 11.2 11.2Z"></path>
              </svg>
            </button>
          </div>
        </div>

        <main id="content" tabindex="-1">
          <slot />
        </main>

        <footer class="site-footer">© {new Date().getFullYear()} {site.author}</footer>
      </div>
    </div>

    <script>
      const menuButton = document.querySelector<HTMLButtonElement>("#menu-button");
      const mobileNavigation = document.querySelector<HTMLElement>("#mobile-navigation");
      const closeMenu = () => {
        menuButton?.setAttribute("aria-expanded", "false");
        menuButton?.setAttribute("aria-label", "開啟選單");
        if (mobileNavigation) mobileNavigation.hidden = true;
      };

      menuButton?.addEventListener("click", () => {
        const open = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!open));
        menuButton.setAttribute("aria-label", open ? "開啟選單" : "關閉選單");
        if (mobileNavigation) mobileNavigation.hidden = open;
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeMenu();
          menuButton?.focus();
        }
      });

      const updateThemeButtonLabels = () => {
        const dark = document.documentElement.dataset.theme === "dark";
        for (const button of document.querySelectorAll<HTMLButtonElement>(".theme-button")) {
          button.setAttribute("aria-label", dark ? "切換淺色模式" : "切換深色模式");
        }
      };

      updateThemeButtonLabels();
      for (const button of document.querySelectorAll<HTMLButtonElement>(".theme-button")) {
        button.addEventListener("click", () => {
          const dark = document.documentElement.dataset.theme !== "dark";
          document.documentElement.dataset.theme = dark ? "dark" : "light";
          localStorage.setItem("theme", dark ? "dark" : "light");
          updateThemeButtonLabels();
        });
      }
    </script>
  </body>
</html>
