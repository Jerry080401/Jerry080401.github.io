---
import { site } from "../config";
import LanguagePicker from "../components/LanguagePicker.astro";
import {
  defaultLocale,
  localePath,
  locales,
  messages,
  navigation,
  stripLocalePath,
  type Locale
} from "../i18n";
import { withBase } from "../lib/url";
import "../styles/global.css";

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  canonical?: boolean;
  noindex?: boolean;
  languagePaths?: Partial<Record<Locale, string>>;
}

const {
  locale = defaultLocale,
  title,
  description: descriptionProp,
  canonical = true,
  noindex = false,
  languagePaths
} = Astro.props;
const copy = messages[locale];
const description = descriptionProp ?? copy.siteDescription;
const pageTitle = title ? `${title} — ${site.title}` : `${site.title} — ${copy.siteSubtitle}`;
const pathname = Astro.url.pathname;
const homePath = localePath(locale, "/");
const isHome = pathname === withBase(homePath);
const sectionLabel = isHome ? "" : (title ?? copy.pageLabel);
const navigationItems = navigation(locale);
const basePath = import.meta.env.BASE_URL;
const pathInsideBase = pathname.startsWith(basePath) ? `/${pathname.slice(basePath.length)}` : pathname;
const logicalPath = stripLocalePath(locale, pathInsideBase);
const resolvedLanguagePaths: Partial<Record<Locale, string>> = languagePaths ?? Object.fromEntries(
  locales.map((language) => [language, localePath(language, logicalPath)])
);
const availableLocales = locales.filter((language) => resolvedLanguagePaths[language]);
const isActive = (href: string) => href === homePath
  ? pathname === withBase(href)
  : pathname.startsWith(withBase(href));
const rssPath = localePath(locale, "/rss.xml");
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase("/favicon.ico")} />
    {canonical && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    {
      availableLocales.map((language) => (
        <link
          rel="alternate"
          hreflang={language}
          href={new URL(withBase(resolvedLanguagePaths[language]!), Astro.site)}
        />
      ))
    }
    {
      resolvedLanguagePaths[defaultLocale] && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(withBase(resolvedLanguagePaths[defaultLocale]), Astro.site)}
        />
      )
    }
    <link rel="alternate" type="application/rss+xml" title={site.title} href={withBase(rssPath)} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    <noscript>
      <style>
        @media (max-width: 760px) {
          .mobile-header { display: none !important; }
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#content">{copy.skipToContent}</a>

    <div class="app-shell">
      <aside class="side-rail">
        <div class="rail-brand-space">
          {!isHome && (
            <a class="rail-brand" href={withBase(homePath)} aria-label={`${site.title} — ${copy.navHome}`}>
              <strong>Jerry's<br />Notes</strong>
              <span>{copy.siteSubtitle}</span>
            </a>
          )}
        </div>

        <nav class="rail-nav" aria-label={copy.mainNavLabel}>
          {
            navigationItems.map((item) => (
              <a href={withBase(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="rail-footer">
          <LanguagePicker locale={locale} paths={resolvedLanguagePaths} mode="desktop" />
          <a href={withBase(rssPath)}>RSS</a>
          <span>© {new Date().getFullYear()} {site.author}</span>
        </div>
      </aside>

      <div class="page-column">
        <header class="mobile-header">
          <div class="mobile-brand-space">
            {!isHome && <a href={withBase(homePath)}>{site.title}</a>}
          </div>
          <button
            class="menu-button"
            id="menu-button"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-navigation"
            aria-label={copy.openMenu}
            data-open-label={copy.openMenu}
            data-close-label={copy.closeMenu}
          >
            <span></span><span></span>
          </button>
          <button
            class="theme-button"
            type="button"
            aria-label={copy.switchDark}
            data-dark-label={copy.switchDark}
            data-light-label={copy.switchLight}
          >
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="3.5"></circle>
              <path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
            </svg>
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 15.2A8.2 8.2 0 0 1 8.8 4a8.2 8.2 0 1 0 11.2 11.2Z"></path>
            </svg>
          </button>
          <nav id="mobile-navigation" class="mobile-nav" aria-label={copy.mobileNavLabel} hidden>
            {
              navigationItems.map((item) => (
                <a href={withBase(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              ))
            }
            <LanguagePicker locale={locale} paths={resolvedLanguagePaths} mode="mobile" />
          </nav>
        </header>

        <noscript>
          <nav class="mobile-noscript-nav" aria-label={copy.mobileNavLabel}>
            {
              navigationItems.map((item) => (
                <a href={withBase(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              ))
            }
            <LanguagePicker locale={locale} paths={resolvedLanguagePaths} mode="mobile" />
          </nav>
        </noscript>

        <div class="utility-bar">
          <span>{sectionLabel}</span>
          <div>
            <a href={withBase(rssPath)}>RSS</a>
            <button
              class="theme-button"
              type="button"
              aria-label={copy.switchDark}
              data-dark-label={copy.switchDark}
              data-light-label={copy.switchLight}
            >
              <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="3.5"></circle>
                <path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
              </svg>
              <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 15.2A8.2 8.2 0 0 1 8.8 4a8.2 8.2 0 1 0 11.2 11.2Z"></path>
              </svg>
            </button>
          </div>
        </div>

        <main id="content" tabindex="-1">
          <slot />
        </main>

        <footer class="site-footer">© {new Date().getFullYear()} {site.author}</footer>
      </div>
    </div>

    <script>
      const menuButton = document.querySelector<HTMLButtonElement>("#menu-button");
      const mobileNavigation = document.querySelector<HTMLElement>("#mobile-navigation");
      const languageDisclosures = Array.from(
        document.querySelectorAll("details[data-language-disclosure]")
      );
      const closeLanguageDisclosures = () => {
        for (const disclosure of languageDisclosures) {
          disclosure.removeAttribute("open");
        }
      };
      const closeMenu = () => {
        menuButton?.setAttribute("aria-expanded", "false");
        menuButton?.setAttribute("aria-label", menuButton.dataset.openLabel ?? "");
        if (mobileNavigation) mobileNavigation.hidden = true;
        closeLanguageDisclosures();
      };

      for (const disclosure of languageDisclosures) {
        disclosure.addEventListener("toggle", () => {
          if (!disclosure.hasAttribute("open")) return;
          for (const otherDisclosure of languageDisclosures) {
            if (otherDisclosure !== disclosure) otherDisclosure.removeAttribute("open");
          }
        });
      }

      document.addEventListener("click", (event) => {
        if (!(event.target instanceof Node)) return;
        for (const disclosure of languageDisclosures) {
          if (disclosure.hasAttribute("open") && !disclosure.contains(event.target)) {
            disclosure.removeAttribute("open");
          }
        }
      });

      menuButton?.addEventListener("click", () => {
        const open = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!open));
        menuButton.setAttribute(
          "aria-label",
          open ? (menuButton.dataset.openLabel ?? "") : (menuButton.dataset.closeLabel ?? "")
        );
        if (mobileNavigation) mobileNavigation.hidden = open;
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          const openDisclosure = languageDisclosures.find((disclosure) =>
            disclosure.hasAttribute("open")
          );
          if (openDisclosure) {
            openDisclosure.removeAttribute("open");
            openDisclosure.querySelector<HTMLElement>("summary")?.focus();
            return;
          }
          closeMenu();
          menuButton?.focus();
        }
      });

      const updateThemeButtonLabels = () => {
        const dark = document.documentElement.dataset.theme === "dark";
        for (const button of document.querySelectorAll<HTMLButtonElement>(".theme-button")) {
          button.setAttribute("aria-label", dark
            ? (button.dataset.lightLabel ?? "")
            : (button.dataset.darkLabel ?? ""));
        }
      };

      updateThemeButtonLabels();
      for (const button of document.querySelectorAll<HTMLButtonElement>(".theme-button")) {
        button.addEventListener("click", () => {
          const dark = document.documentElement.dataset.theme !== "dark";
          document.documentElement.dataset.theme = dark ? "dark" : "light";
          localStorage.setItem("theme", dark ? "dark" : "light");
          updateThemeButtonLabels();
        });
      }
    </script>
  </body>
</html>
