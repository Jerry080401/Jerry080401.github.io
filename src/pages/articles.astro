---
import PostList from "../components/PostList.astro";
import { getPublishedPosts } from "../lib/posts";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getPublishedPosts()).filter((post) => post.data.category === "文章");
---

<BaseLayout title="文章">
  <section class="page-shell">
    <header class="page-header">
      <h1>文章</h1>
      <p>經過整理，適合完整閱讀的主題內容。</p>
    </header>
    <PostList posts={posts} emptyText="整理完成的文章會出現在這裡。" />
  </section>
</BaseLayout>